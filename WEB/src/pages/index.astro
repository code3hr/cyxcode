---
import BaseLayout from "../components/BaseLayout.astro"
import Terminal from "../components/Terminal.astro"
import InstallCommand from "../components/InstallCommand.astro"
import { docs, repo, route, install } from "../data/site"
import demo from "../../Cyxcode.mp4"
---

<BaseLayout
  title="CyxCode"
  description="Your code. Your context. Your agent. CyxCode brings project memory, local error recovery, and governed tools to an open-source AI coding workflow."
>
  <section class="landing-hero" aria-labelledby="hero-title">
    <div class="hero-message">
      <a class="announcement" href={route("/about")}
        ><span class="status-dot"></span> Open source. Built to be yours. <span aria-hidden="true">↗</span></a
      >
      <h1 id="hero-title">Your code.<br />Your context.<br /><em>Your advantage.</em></h1>
      <p class="hero-lead">
        Meet the coding agent that keeps what you learn. Build with AI, remember project decisions, and turn familiar
        errors into reusable fixes.
      </p>
      <div class="hero-actions">
        <a class="btn cta" href={route("/install")}>Get started <span aria-hidden="true">↗</span></a><a
          class="btn ghost"
          href={repo}
          target="_blank"
          rel="noreferrer noopener">View on GitHub <span aria-hidden="true">↗</span></a
        >
      </div>
      <div class="hero-notes"><span>Terminal native</span><span>Model flexible</span><span>Open source</span></div>
    </div>
    <div class="hero-product">
      <div class="product-label"><span>THE CYXCODE WORKFLOW</span><span>TRY THE TABS ↓</span></div><Terminal /><p
        class="product-caption"
      >
        <span>Familiar failure. Local pattern. Reviewed fix.</span><a href="#demo"
          >Watch a real session <span aria-hidden="true">↘</span></a
        >
      </p>
    </div>
  </section>
  <section class="principles" aria-label="Built for your workflow">
    <p>Fits the way<br /><strong>you already build.</strong></p><div>
      <span aria-hidden="true">&gt;_</span> Your terminal
    </div><div><span aria-hidden="true">⌘</span> Your repository</div><div>
      <span aria-hidden="true">◇</span> Your model
    </div><div><span aria-hidden="true">⎇</span> Your rules</div>
  </section>
  <section class="capabilities" aria-labelledby="capabilities-title">
    <div class="section-intro">
      <div>
        <p class="kicker">01 / Built around your project</p><h2 id="capabilities-title">
          Good work shouldn't<br />start from zero.
        </h2>
      </div><p>
        Code is only part of the context.<br />Keep the decisions, fixes, and guardrails<br />that make a project yours.
      </p>
    </div>
    <div class="capability-grid">
      <a class="capability memory-card" href={route("/knowledge")}
        ><div class="card-heading"><span class="card-number">01</span><span aria-hidden="true">↗</span></div><h3>
          A memory for your codebase.
        </h3><p>
          Save conventions and decisions as compact project knowledge. Bring useful context into the next session.
        </p><div class="memory-preview" aria-hidden="true">
          <div><span>project / memory</span><span>3 notes</span></div><p>
            <span>↳</span> Use Bun for package scripts <small>convention</small>
          </p><p><span>↳</span> Keep the API stateless <small>architecture</small></p><p>
            <span>↳</span> Test from package directories <small>workflow</small>
          </p>
        </div><span class="card-link">Explore project knowledge <span aria-hidden="true">→</span></span></a
      >
      <a class="capability recovery-card" href={route("/features#learning")}
        ><div class="card-heading"><span class="card-number">02</span><span aria-hidden="true">↗</span></div><h3>
          Some errors need no introduction.
        </h3><p>
          Match familiar failures against built-in and approved patterns. Get a suggested fix without a model call for
          diagnosis.
        </p><div class="recovery-preview" aria-hidden="true">
          <span>error</span><i>→</i><strong>local pattern</strong><i>→</i><span>suggested fix</span>
        </div><span class="card-link">Meet pattern-first recovery <span aria-hidden="true">→</span></span></a
      >
      <a class="capability watch-card" href={route("/cyxwatch")}
        ><div class="card-heading"><span class="card-number">03</span><span aria-hidden="true">↗</span></div><h3>
          Visibility before autonomy.
        </h3><p>
          CyxWatch brings local audit trails and policy checks to covered commands, file operations, and runtime
          activity.
        </p><div class="watch-preview" aria-hidden="true">
          <span>shell.execute</span><span class="policy">require approval</span>
        </div><span class="card-link">Discover CyxWatch <span aria-hidden="true">→</span></span></a
      >
      <a class="capability model-card" href={route("/install#models")}
        ><div class="card-heading"><span class="card-number">04</span><span aria-hidden="true">↗</span></div><h3>
          Your model. Your call.
        </h3><p>
          Connect your provider or configure a local model. Choose the tools that fit your project and your budget.
        </p><div class="model-preview" aria-hidden="true">
          <code>/connect</code><span>→</span><code>/models</code>
        </div><span class="card-link">Connect a model <span aria-hidden="true">→</span></span></a
      >
    </div>
  </section>
  <section class="workflow" aria-labelledby="workflow-title">
    <div class="section-intro">
      <div>
        <p class="kicker">02 / A better feedback loop</p><h2 id="workflow-title">
          Solve it. Review it.<br />Build on it.
        </h2>
      </div><a class="text-link" href={route("/features")}>Explore all features <span aria-hidden="true">↗</span></a>
    </div><div class="workflow-grid">
      <article>
        <span>01 / WORK</span><h3>Stay close to the code.</h3><p>
          Explore a repository, plan a change, edit files, and run commands in one agent workflow.
        </p>
      </article><article>
        <span>02 / LEARN</span><h3>Keep the useful parts.</h3><p>
          Save a decision. Review a captured error and fix. Approve the patterns worth reusing.
        </p>
      </article><article>
        <span>03 / REUSE</span><h3>Bring context forward.</h3><p>
          Retrieve relevant notes and match known failures as you work on the next task.
        </p>
      </article>
    </div>
  </section>
  <section id="demo" class="demo-section" aria-labelledby="demo-title">
    <div class="section-intro">
      <div><p class="kicker">03 / Inside CyxCode</p><h2 id="demo-title">Less abstract.<br />More in action.</h2></div><p
      >
        A recorded CyxCode session.<br />See the terminal workflow for yourself.
      </p>
    </div><div class="demo-frame">
      <div class="demo-bar"><span><i></i> CYXCODE / SESSION RECORDING</span><span>PLAY TO EXPLORE</span></div><video
        controls
        playsinline
        preload="none"
        poster={route("/gallery/demo-poster.jpg")}
        ><source src={demo} type="video/mp4" /><a href={demo}>Download the CyxCode session recording</a></video
      >
    </div><p class="demo-note">
      Recorded interface; available models and features depend on your version and connected provider.
    </p>
  </section>
  <section class="start-section" aria-labelledby="start-title">
    <div>
      <p class="kicker">Your next session starts here</p><h2 id="start-title">
        Make it your<br /><em>coding environment.</em>
      </h2><p>Open source. Built on OpenCode. Shaped for CyxCode.</p><div class="hero-actions">
        <a class="btn cta" href={route("/install")}>Install CyxCode <span aria-hidden="true">↗</span></a><a
          class="text-link"
          href={docs}
          target="_blank"
          rel="noreferrer noopener">Read the docs <span aria-hidden="true">↗</span></a
        >
      </div>
    </div><div class="start-command">
      <span class="command-label">ONE COMMAND TO GET STARTED</span><InstallCommand command={install} /><p>
        macOS · Linux · Windows via WSL / Git Bash
      </p><a href={route("/install")}>All installation options <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
<style>
  .landing-hero {
    display: grid;
    grid-template-columns: 1fr 1.08fr;
    gap: 64px;
    align-items: center;
    padding: 30px 0 70px;
  }
  .announcement {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    color: #bdcbbf;
    font-size: 11px;
    border: 1px solid var(--line);
    border-radius: 30px;
    padding: 8px 12px;
    margin-bottom: 30px;
  }
  .status-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--mint);
  }
  h1 {
    font-size: clamp(3.1rem, 5.1vw, 4.65rem);
    line-height: 1.04;
    letter-spacing: -0.065em;
    font-weight: 500;
  }
  em {
    font-style: normal;
    color: var(--mint);
  }
  .hero-lead {
    font-size: 16px;
    line-height: 1.85;
    color: var(--muted);
    max-width: 440px;
    margin: 25px 0 29px;
  }
  .hero-actions {
    align-items: center;
    gap: 12px;
  }
  .hero-notes {
    display: flex;
    flex-wrap: wrap;
    gap: 19px;
    margin-top: 23px;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 10px;
  }
  .hero-notes span::before {
    content: "✓";
    color: var(--mint);
    margin-right: 6px;
  }
  .hero-product {
    min-width: 0;
    position: relative;
  }
  .product-label,
  .product-caption {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 9px;
  }
  .product-label {
    margin-bottom: 12px;
    letter-spacing: 1px;
  }
  .product-caption {
    margin-top: 15px;
    line-height: 1.8;
    flex-wrap: wrap;
  }
  .product-caption a {
    color: #c1cfc3;
  }
  .principles {
    display: grid;
    grid-template-columns: 1.35fr repeat(4, 1fr);
    align-items: center;
    gap: 22px;
    padding: 29px 0;
    border-block: 1px solid var(--line);
  }
  .principles p {
    color: var(--faint);
    font-size: 12px;
    line-height: 1.8;
  }
  .principles strong {
    color: var(--muted);
    font-weight: 400;
  }
  .principles div {
    display: flex;
    align-items: center;
    gap: 13px;
    font-size: 13px;
    color: #c5cec7;
  }
  .principles div > span {
    font-family: var(--font-mono);
    font-size: 23px;
    color: var(--faint);
  }
  .capabilities,
  .workflow,
  .demo-section {
    padding-top: 105px;
  }
  .section-intro {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 38px;
  }
  .section-intro h2 {
    font-size: clamp(2.1rem, 3.1vw, 3rem);
    letter-spacing: -0.055em;
    font-weight: 500;
  }
  .section-intro > p {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.9;
  }
  .capability-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .capability {
    display: flex;
    flex-direction: column;
    background: var(--bg-1);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 30px;
    min-width: 0;
    transition: border-color 160ms;
  }
  .capability:hover {
    border-color: #76927b;
  }
  .card-heading {
    display: flex;
    justify-content: space-between;
    color: var(--faint);
    font-family: var(--font-mono);
    margin-bottom: 26px;
    font-size: 13px;
  }
  .card-number {
    font-size: 11px;
  }
  .capability h3 {
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.035em;
  }
  .capability > p {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.8;
    margin-top: 11px;
    max-width: 44ch;
  }
  .card-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    margin-top: auto;
    padding-top: 28px;
    color: #d4dfd6;
  }
  .memory-preview {
    margin-top: 26px;
    border: 1px solid var(--line);
    border-radius: 7px;
    font: 10px var(--font-mono);
    background: var(--bg-0);
  }
  .memory-preview > div {
    padding: 11px 14px;
    display: flex;
    justify-content: space-between;
    color: var(--faint);
    border-bottom: 1px solid var(--line);
  }
  .memory-preview p {
    display: flex;
    gap: 8px;
    padding: 12px 14px;
    color: #c8d5cb;
  }
  .memory-preview p + p {
    border-top: 1px solid #ffffff06;
  }
  .memory-preview p > span {
    color: var(--mint);
  }
  .memory-preview small {
    margin-left: auto;
    color: var(--faint);
    font-size: 8px;
  }
  .recovery-preview {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 9px;
    font: 10px var(--font-mono);
    margin-block: auto;
    padding: 48px 0 24px;
  }
  .recovery-preview span,
  .recovery-preview strong {
    padding: 13px 10px;
    border: 1px solid var(--line);
    border-radius: 5px;
    color: var(--muted);
    font-weight: 400;
  }
  .recovery-preview strong {
    border-color: #b8f3bd45;
    background: var(--mint-soft);
    color: var(--mint);
  }
  .recovery-preview i {
    font-style: normal;
    color: var(--faint);
  }
  .watch-preview {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
    border: 1px solid var(--line);
    background: var(--bg-0);
    border-radius: 7px;
    padding: 16px;
    font: 10px var(--font-mono);
    color: var(--muted);
  }
  .policy {
    color: var(--amber);
    background: var(--amber-soft);
    padding: 5px 8px;
    border-radius: 4px;
  }
  .model-preview {
    display: flex;
    align-items: center;
    gap: 17px;
    margin-top: 28px;
    font: 13px var(--font-mono);
    color: var(--faint);
  }
  .model-preview code {
    padding: 15px 20px;
    border: 1px solid var(--line);
    background: var(--bg-0);
    border-radius: 7px;
    color: var(--mint);
  }
  .workflow-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 35px;
  }
  .workflow-grid article {
    border-top: 1px solid var(--line);
    padding-top: 23px;
  }
  .workflow-grid article > span {
    font: 10px var(--font-mono);
    letter-spacing: 1px;
    color: var(--mint);
  }
  .workflow-grid h3 {
    font-size: 18px;
    font-weight: 500;
    margin: 20px 0 12px;
  }
  .workflow-grid p {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.85;
  }
  .demo-frame {
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg-1);
  }
  .demo-bar {
    padding: 17px 23px;
    display: flex;
    justify-content: space-between;
    gap: 15px;
    color: var(--faint);
    font: 9px var(--font-mono);
    letter-spacing: 1px;
  }
  .demo-bar i {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--mint);
    margin-right: 8px;
  }
  video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: contain;
    background: #0c100e;
  }
  .demo-note {
    margin-top: 14px;
    font-size: 11px;
    color: var(--faint);
  }
  .start-section {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 70px;
    align-items: center;
    padding: 65px 0 20px;
    border-top: 1px solid var(--line);
  }
  .start-section h2 {
    font-size: clamp(2rem, 3vw, 2.85rem);
    font-weight: 500;
    letter-spacing: -0.055em;
  }
  .start-section p {
    font-size: 13px;
    color: var(--muted);
    margin-top: 20px;
  }
  .start-section .hero-actions {
    margin-top: 25px;
  }
  .start-command {
    min-width: 0;
  }
  .command-label {
    display: block;
    font: 9px var(--font-mono);
    color: var(--faint);
    letter-spacing: 1px;
    margin-bottom: 14px;
  }
  .start-command p {
    font-size: 10px;
    margin-top: 12px;
  }
  .start-command > a {
    display: inline-block;
    font-size: 12px;
    color: var(--mint);
    margin-top: 15px;
  }
  @media (max-width: 1050px) {
    .landing-hero {
      gap: 30px;
    }
    h1 {
      font-size: 3.4rem;
    }
    .hero-notes {
      gap: 11px;
    }
  }
  @media (max-width: 800px) {
    .landing-hero {
      grid-template-columns: 1fr;
      padding-top: 5px;
      gap: 45px;
    }
    h1 {
      font-size: clamp(3rem, 8vw, 4.5rem);
    }
    .hero-lead {
      max-width: 520px;
    }
    .hero-product {
      max-width: 620px;
      width: 100%;
    }
    .principles {
      grid-template-columns: 1fr 1fr;
      gap: 23px;
    }
    .principles > p {
      grid-column: 1 / -1;
    }
    .principles br {
      display: none;
    }
    .capabilities,
    .workflow,
    .demo-section {
      padding-top: 70px;
    }
    .section-intro {
      align-items: flex-start;
      flex-direction: column;
      gap: 20px;
    }
    .capability {
      padding: 23px;
    }
    .start-section {
      grid-template-columns: 1fr;
      gap: 35px;
      padding-top: 45px;
    }
  }
  @media (max-width: 600px) {
    .capability-grid,
    .workflow-grid {
      grid-template-columns: 1fr;
    }
    .memory-preview small {
      display: none;
    }
    .capability h3 {
      font-size: 21px;
    }
    .demo-bar {
      font-size: 8px;
      padding-inline: 14px;
    }
    .demo-bar > span:last-child {
      display: none;
    }
    .hero-actions .btn {
      flex: 1;
    }
    .announcement {
      font-size: 10px;
    }
    .product-caption {
      font-size: 8px;
    }
  }
</style>
