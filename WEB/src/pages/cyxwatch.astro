---
import BaseLayout from "../components/BaseLayout.astro"
import SectionHeading from "../components/SectionHeading.astro"
import { doc, route } from "../data/site"

const watchDoc = "https://github.com/code3hr/cyxcode/blob/dev/docs/security_layer.md"
const fwDoc = `${watchDoc}#persistent-memory-profiling`
const policyDoc = doc("USAGE.md")
---

<BaseLayout
  title="CyxWatch"
  description="CyxWatch is CyxCode's local runtime observability and policy layer for instrumented agent activity, persistent state, and high-confidence secret redaction."
  path="/cyxwatch"
>
  <section class="page-hero reveal">
    <p class="eyebrow">Runtime security layer</p>
    <h1>See and govern the agent's core runtime activity.</h1>
    <p class="lead">
      CyxWatch records instrumented prompt turns, shell commands, file operations, network attempts, and memory events locally.
      Policy checks can flag, require approval for, or block covered operations before execution, while high-confidence secrets
      are redacted before persistent storage.
    </p>
    <div class="hero-actions">
      <a class="btn cta" href={route("/install")}>Install CyxCode</a>
      <a class="btn ghost" href={watchDoc} target="_blank" rel="noreferrer noopener">Implementation doc ↗</a>
    </div>
  </section>

  <!-- What it tracks -->
  <section class="content-band">
    <SectionHeading kicker="Observability" title="Local telemetry by default" subtitle="Coverage follows the shared runtime wrappers documented in the implementation guide." />
    <div class="feature-grid">
      <article class="feature reveal">
        <h3>Prompt turns</h3>
        <p>Correlated by session and message, so every model call is traceable back to its context.</p>
      </article>
      <article class="feature reveal">
        <h3>Shell commands</h3>
        <p>What ran, when, and against what — with risk flags for destructive strings and sensitive paths.</p>
      </article>
      <article class="feature reveal">
        <h3>File reads &amp; writes</h3>
        <p>Instrumented filesystem touchpoints are logged, with covered writes checked against policy before they land on disk.</p>
      </article>
      <article class="feature reveal">
        <h3>Risk flags</h3>
        <p>Automatic detection of sensitive paths and risky shell patterns on covered operations before execution.</p>
      </article>
    </div>
  </section>

  <section class="dashboard-shot reveal">
    <figure class="panel">
      <a href={route("/gallery/dashboard-security.png")} target="_blank" rel="noreferrer noopener">
        <img src={route("/gallery/dashboard-security.png")} alt="CyxWatch runtime security and vulnerability scan dashboard" loading="lazy" />
      </a>
    </figure>
    <div>
      <p class="kicker">Dashboard</p>
      <h2>Runtime signals in one place.</h2>
      <p>Open the CyxWatch surface to review telemetry and policy signals or start the shipped project vulnerability scan.</p>
    </div>
  </section>

  <!-- Memory firewall -->
  <section class="content-band">
    <SectionHeading
      kicker="Memory firewall"
      title="Filter secrets before long-term state"
      subtitle="Persistent memory and audit writes pass through high-confidence secret detection and redaction."
    />
    <div class="flow-cards">
      <article class="feature reveal">
        <h3>Intercept</h3>
        <p>Persistent memory writes pass through a filter that scans known API key, JWT, password, and token formats.</p>
      </article>
      <div class="flow-arrow reveal">→</div>
      <article class="feature reveal">
        <h3>Redact</h3>
        <p>High-confidence matches are scrubbed before storage. The same redaction boundary protects audit records.</p>
      </article>
      <div class="flow-arrow reveal">→</div>
      <article class="feature reveal">
        <h3>Persist</h3>
        <p>Filtered context reaches <code>.cyxcode/memory/</code>, reducing secret persistence in recall, dream, and graph state.</p>
      </article>
    </div>
    <p class="doc-link reveal">
      <a class="text-link" href={fwDoc} target="_blank" rel="noreferrer noopener">Read the memory firewall design ↗</a>
    </p>
  </section>

  <!-- Policy engine -->
  <section class="content-band">
    <SectionHeading kicker="Policy engine" title="Decisions enforced before execution" />
    <div class="table-wrap reveal">
      <table>
        <thead>
          <tr><th>Decision</th><th>What happens</th></tr>
        </thead>
        <tbody>
          <tr><td><strong>auto-approve</strong></td><td>Matching operation runs with no prompt.</td></tr>
          <tr><td><strong>require-approval</strong></td><td>Normal permission prompt is shown.</td></tr>
          <tr><td><strong>block</strong></td><td>Tool call stops before it executes. Hard blocks also guard low-level wrappers — destructive process-wrapper commands are caught pre-spawn, filesystem writes pre-write.</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- CLI -->
  <section class="content-band">
    <SectionHeading kicker="Surface" title="Inspect from the CLI or dashboard" />
    <article class="panel reveal term-block">
      <pre><code><span class="t-prompt">$ </span>cyxcode watch recent          <span class="t-out"># recent telemetry</span>
<span class="t-prompt">$ </span>cyxcode watch report          <span class="t-out"># observability report</span>
<span class="t-prompt">$ </span>cyxcode watch alerts          <span class="t-out"># alert history</span>
<span class="t-prompt">$ </span>cyxcode watch policy          <span class="t-out"># saved project policy rules</span>
<span class="t-prompt">$ </span>cyxcode watch policy --effective  <span class="t-out"># include defaults</span>
<span class="t-prompt">$ </span>cyxcode watch report --json --period 30d</code></pre>
    </article>
    <p class="doc-link reveal" style="margin-top:1rem">
      Or open the dashboard at <code>/dashboard/security</code> when running <code>cyxcode web</code>.
      <a class="text-link" href={policyDoc} target="_blank" rel="noreferrer noopener" style="margin-left:0.5rem">Full usage guide ↗</a>
    </p>
  </section>

  <section class="content-band">
    <div class="panel panel--accent closing-cta reveal">
      <div>
        <h2>Visibility before autonomy.</h2>
        <p>CyxWatch ships with CyxCode and keeps telemetry local. See the implementation guide for current coverage and known boundaries.</p>
      </div>
      <a class="btn cta" href={route("/install")}>Install CyxCode →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { max-width: 56ch; margin-bottom: 1rem; }
  .page-hero .lead { font-size: 1.125rem; line-height: 1.7; color: var(--muted); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .flow-cards {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    gap: 0.75rem;
    align-items: stretch;
  }
  .flow-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--mint);
    font-size: 1.5rem;
  }
  .doc-link { margin-top: 1rem; }
  .dashboard-shot { display: grid; grid-template-columns: minmax(20rem, 1.15fr) minmax(18rem, 0.85fr); gap: 3rem; align-items: center; }
  .dashboard-shot figure { margin: 0; padding: 0; overflow: hidden; }
  .dashboard-shot img { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; }
  .dashboard-shot p:not(.kicker) { margin-top: 0.75rem; color: var(--muted); line-height: 1.7; }
  code {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.88em;
    color: var(--mint);
    background: rgba(36, 209, 163, 0.1);
    padding: 0.1em 0.4em;
    border-radius: 4px;
  }
  .term-block pre {
    margin: 0;
    padding: 1.25rem;
    background: rgba(4, 8, 16, 0.6);
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.9;
  }
  .t-prompt { color: var(--mint); }
  .t-out { color: var(--faint); }
  .closing-cta {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: 1.5rem; padding: 2.5rem;
  }
  .closing-cta p { color: var(--muted); }
  @media (max-width: 900px) {
    .flow-cards { grid-template-columns: 1fr; }
    .dashboard-shot { grid-template-columns: 1fr; }
    .flow-arrow { transform: rotate(90deg); }
  }
  @media (max-width: 768px) { .closing-cta { padding: 1.75rem; } }
</style>
