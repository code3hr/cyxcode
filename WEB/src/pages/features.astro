---
import BaseLayout from "../components/BaseLayout.astro"
import { route } from "../data/site"
import SectionHeading from "../components/SectionHeading.astro"
import { route } from "../data/site"

const features = [
  {
    title: "Shell mode",
    body: "Prefix any command with <code>!</code> and CyxCode runs it directly without spending a model turn. Known failures are matched before the agent runs, so the fix appears instantly and repeated errors stay free.",
    shot: {
      src: "/gallery/screenshot-cyxcode-shell.png",
      alt: "CyxCode shell mode catching a command failure in the terminal",
    },
  },
  {
    title: "Pattern learning",
    body: "When a pattern misses, the agent handles the failure once, then CyxCode captures the error, proposed fix, and generated regex for review. Approved patterns become reusable guardrails for the next session.",
    shot: {
      src: "/gallery/screenshot-cyxcode-learn-review.png",
      alt: "CyxCode pattern learning review screen",
    },
  },
  {
    title: "Project memory",
    body: "Small indexed files in <code>.cyxcode/memory/</code> preserve decisions, conventions, and discoveries. Recall loads only what is relevant, so useful project knowledge returns without flooding the prompt.",
    shot: {
      src: "/gallery/screenshot-cyxcode-memory.png",
      alt: "CyxCode project memory view with saved context",
    },
  },
  {
    title: "Semantic recall",
    body: "When no exact pattern matches, local semantic recall searches prior errors and project context for near matches. The agent gets a better starting point while the lookup stays local and free.",
    shot: {
      src: "/gallery/screenshot-cyxcode.png",
      alt: "CyxCode terminal workflow screenshot",
    },
  },
]
---

<BaseLayout
  title="Features"
  description="CyxCode features shown through real terminal screenshots: shell mode, pattern learning, project memory, and semantic recall."
  path="/features"
>
  <section class="page-hero reveal">
    <p class="eyebrow">Deep dive</p>
    <h1>Core capabilities, shown in the terminal.</h1>
    <p class="lead">
      A direct look at the CyxCode workflow: what appears in the terminal, and what each capability does in practice.
    </p>
  </section>

  <section class="features-list">
    {
      features.map((f, i) => (
        <article id={f.title.toLowerCase().replace(/\s+/g, "-")} class:list={["feature-row", "reveal", i % 2 === 1 && "flip"]}>
          <figure class="feature-shot">
            <a href={f.shot.src} target="_blank" rel="noreferrer noopener">
              <img src={f.shot.src} alt={f.shot.alt} loading="lazy" />
            </a>
          </figure>
          <div class="feature-body">
            <h2>{f.title}</h2>
            <p set:html={f.body} />
          </div>
        </article>
      ))
    }
  </section>

  <section class="content-band">
    <SectionHeading kicker="Commands" title="Everything at a glance" align="center" />
    <div class="table-wrap reveal" style="max-width:760px;margin-inline:auto">
      <table>
        <thead>
          <tr><th>Command</th><th>What it does</th></tr>
        </thead>
        <tbody>
          <tr><td><code>/cyxinit</code></td><td>Initialize <code>.cyxcode/</code> in a project</td></tr>
          <tr><td><code>/remember &lt;info&gt;</code></td><td>Save a memory manually</td></tr>
          <tr><td><code>/learn-patterns</code></td><td>Review and approve learned patterns</td></tr>
          <tr><td><code>/dream</code></td><td>Consolidate memories, patterns, and stats</td></tr>
          <tr><td><code>/update</code></td><td>Upgrade to the latest release</td></tr>
          <tr><td><code>cyxcode audit</code></td><td>Show recent audit events</td></tr>
          <tr><td><code>cyxcode report</code></td><td>Generate a token savings report</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="content-band">
    <div class="panel panel--accent closing-cta reveal">
      <div>
        <h2>See it in your terminal.</h2>
        <p>Install once. The pattern library starts growing on your first error.</p>
      </div>
      <a class="btn cta" href={route("/install")}>Install CyxCode -></a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    max-width: 58ch;
    margin-bottom: 2rem;
  }
  .page-hero .lead {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--muted);
  }
  .features-list {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }
  .feature-row {
    display: grid;
    grid-template-columns: minmax(20rem, 1.05fr) minmax(18rem, 0.95fr);
    column-gap: 3rem;
    align-items: center;
    padding: 2.5rem 0 0;
    border-top: 1px solid var(--line-soft);
  }
  .feature-body h2 {
    margin-bottom: 1rem;
  }
  .feature-body p {
    max-width: 42rem;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .feature-shot {
    grid-column: 1;
    margin: 0;
    height: clamp(20rem, 31vw, 29rem);
    overflow: hidden;
    border-radius: 14px;
    background: rgba(4, 8, 16, 0.42);
    box-shadow: 0 18px 60px -28px rgba(0, 0, 0, 0.8);
  }
  .feature-shot a {
    display: block;
    height: 100%;
    cursor: zoom-in;
  }
  .feature-shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    border-radius: inherit;
    transform-origin: center top;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .feature-row.reveal .feature-shot {
    opacity: 0;
    transform: translateX(-2rem) scale(0.96);
    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .feature-row.reveal.flip .feature-shot {
    transform: translateX(2rem) scale(0.96);
  }
  .feature-row.reveal.is-visible .feature-shot {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
  .feature-row.flip .feature-shot {
    grid-column: 2;
    grid-row: 1;
  }
  .feature-row.flip .feature-body {
    grid-column: 1;
    grid-row: 1;
  }
  .feature-shot:hover {
    position: relative;
    z-index: 3;
  }
  .feature-row.reveal.is-visible .feature-shot:hover {
    transform: translateX(0) scale(1.02);
  }
  .feature-shot:hover img {
    transform: scale(1.12);
    box-shadow: 0 24px 90px -24px rgba(0, 0, 0, 0.85);
  }
  code {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.88em;
    color: var(--mint);
  }
  .feature-body code,
  td code {
    background: rgba(36, 209, 163, 0.1);
    padding: 0.1em 0.4em;
    border-radius: 4px;
  }
  .closing-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 2.5rem;
  }
  .closing-cta p { color: var(--muted); }
  @media (max-width: 1000px) {
    .feature-row {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .feature-shot,
    .feature-row.flip .feature-shot,
    .feature-row.flip .feature-body {
      grid-column: 1;
      grid-row: auto;
    }
    .feature-shot {
      height: clamp(18rem, 68vw, 30rem);
    }
  }
  @media (max-width: 768px) {
    .closing-cta { padding: 1.75rem; }
  }
</style>
