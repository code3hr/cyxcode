---
import BaseLayout from "../components/BaseLayout.astro"
import SectionHeading from "../components/SectionHeading.astro"
import { doc, route } from "../data/site"

const layers = [
  { title: "Project memory", text: "Small indexed notes preserve decisions, conventions, and discoveries without loading an entire archive into every prompt." },
  { title: "Markdown wiki", text: "Local notes use familiar markdown, wikilinks, backlinks, tags, and CRUD commands. Relevant notes can join prompt context." },
  { title: "Code graph", text: "A lightweight source scanner records file imports, imported symbols, and top-level declarations." },
  { title: "Unified graph", text: "Wiki, code, memories, learned patterns, semantic facts, and CyxWatch signals become connected nodes rather than separate silos." },
  { title: "Semantic recall", text: "Local MiniLM embeddings find similar prior errors and related project context when exact keyword or regex matching is not enough." },
  { title: "Dream and versioning", text: "Consolidation removes stale state while corrections and recovery summaries preserve the decisions that should survive sessions." },
]

const cmds = [
  ["cyxcode init", "Create the project wiki, memory, graph, history, and pattern structure"],
  ["/remember <info>", "Save a compact memory for later sessions"],
  ["cyxcode wiki create <title>", "Create a local markdown wiki note"],
  ["cyxcode wiki query [terms]", "Search indexed notes"],
  ["cyxcode graph query [terms]", "Search connected project knowledge"],
  ["/dream", "Consolidate and validate accumulated state"],
]
---

<BaseLayout
  title="Knowledge"
  description="CyxCode connects project memory, markdown wiki notes, source relationships, learned patterns, and local semantic recall."
  path="/knowledge"
>
  <section class="page-hero reveal">
    <p class="eyebrow">Local project knowledge</p>
    <h1>Give the agent context that survives the chat.</h1>
    <p class="lead">
      CyxCode keeps useful project knowledge close to the repository, connects it across several small indexes,
      and retrieves only the context that helps the current task.
    </p>
    <div class="hero-actions">
      <a class="btn cta" href={route("/install")}>Initialize a project</a>
      <a class="btn ghost" href={doc("WIKI.md")} target="_blank" rel="noreferrer noopener">Read the wiki docs -&gt;</a>
    </div>
  </section>

  <section class="content-band">
    <SectionHeading kicker="Retrieval loop" title="Capture, connect, retrieve" subtitle="Each layer has a narrow job, so project knowledge stays understandable and replaceable." />
    <div class="flow">
      <article class="panel reveal"><span>01</span><h3>Capture</h3><p>Save a memory, write a wiki note, approve a learned pattern, or let CyxCode index source relationships.</p></article>
      <div class="arrow reveal">-&gt;</div>
      <article class="panel reveal"><span>02</span><h3>Connect</h3><p>Wikilinks, imports, tags, symbols, semantic facts, and runtime signals become typed graph relationships.</p></article>
      <div class="arrow reveal">-&gt;</div>
      <article class="panel reveal"><span>03</span><h3>Retrieve</h3><p>Keyword, graph-neighbor, and local semantic searches return a small relevant context set for the prompt.</p></article>
    </div>
  </section>

  <section class="knowledge-shot reveal">
    <figure class="panel">
      <a href={route("/gallery/dashboard-graph.png")} target="_blank" rel="noreferrer noopener">
        <img src={route("/gallery/dashboard-graph.png")} alt="CyxCode knowledge graph connecting wiki, memory, source, fact, and CyxWatch nodes" loading="lazy" />
      </a>
    </figure>
    <div>
      <p class="kicker">Connected context</p>
      <h2>See how project knowledge fits together.</h2>
      <p>The dashboard connects wiki notes, memory, source relationships, semantic facts, and CyxWatch signals. Nearby graph context can return when it matches the task, while unrelated history stays on disk.</p>
      <a class="text-link" href={doc("RECALL.md")} target="_blank" rel="noreferrer noopener">Read the recall architecture -&gt;</a>
    </div>
  </section>

  <section class="content-band">
    <SectionHeading kicker="Layers" title="One system, small composable parts" />
    <div class="feature-grid">
      {layers.map((layer) => <article class="feature reveal"><h3>{layer.title}</h3><p>{layer.text}</p></article>)}
    </div>
  </section>

  <section class="content-band">
    <SectionHeading kicker="Commands" title="Start with plain files and a few entry points" align="center" />
    <div class="table-wrap reveal commands">
      <table>
        <thead><tr><th>Command</th><th>What it does</th></tr></thead>
        <tbody>{cmds.map((cmd) => <tr><td><code>{cmd[0]}</code></td><td>{cmd[1]}</td></tr>)}</tbody>
      </table>
    </div>
    <p class="docs reveal">
      <a class="text-link" href={doc("WIKI.md")} target="_blank" rel="noreferrer noopener">Wiki docs -&gt;</a>
      <a class="text-link" href={doc("RECALL.md")} target="_blank" rel="noreferrer noopener">Recall docs -&gt;</a>
      <a class="text-link" href={doc("STATE-VERSIONING.md")} target="_blank" rel="noreferrer noopener">State versioning docs -&gt;</a>
    </p>
  </section>
</BaseLayout>

<style>
  .page-hero { max-width: 66ch; }
  .page-hero .lead { font-size: 1.125rem; line-height: 1.7; color: var(--muted); }
  .flow { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; gap: 0.75rem; align-items: stretch; }
  .flow article { padding: 1.5rem; }
  .flow span { display: inline-block; margin-bottom: 1rem; color: var(--mint); font-family: "JetBrains Mono", monospace; font-size: 0.8rem; }
  .flow p, .knowledge-shot p { margin-top: 0.65rem; color: var(--muted); line-height: 1.7; }
  .arrow { display: grid; place-items: center; color: var(--mint); }
  .knowledge-shot { display: grid; grid-template-columns: minmax(20rem, 1.15fr) minmax(18rem, 0.85fr); gap: 3rem; align-items: center; }
  .knowledge-shot figure { overflow: hidden; padding: 0; }
  .knowledge-shot img { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; }
  .knowledge-shot .text-link { margin-top: 1rem; }
  .commands { max-width: 860px; margin-inline: auto; }
  .docs { display: flex; flex-wrap: wrap; justify-content: center; gap: 1.5rem; }
  code { font-family: "JetBrains Mono", monospace; font-size: 0.88em; color: var(--mint); background: rgba(36, 209, 163, 0.1); padding: 0.1em 0.4em; border-radius: 4px; }
  @media (max-width: 900px) { .flow, .knowledge-shot { grid-template-columns: 1fr; } .arrow { transform: rotate(90deg); } }
</style>
