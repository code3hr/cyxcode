---
import Logo from "./cyxcode-logo.astro"
import { docs, opencode, repo, releases, sponsor, route } from "../data/site"
const year = new Date().getFullYear()
const groups = [
  {
    title: "Product",
    links: [
      ["Features", route("/features")],
      ["Knowledge", route("/knowledge")],
      ["CyxWatch", route("/cyxwatch")],
      ["Install", route("/install")],
    ],
  },
  {
    title: "Resources",
    links: [
      ["Documentation", docs],
      ["Releases", releases],
      ["FAQ", route("/faq")],
    ],
  },
  {
    title: "Community",
    links: [
      ["GitHub", repo],
      ["About CyxCode", route("/about")],
      ["Sponsor the project", route("/sponsor")],
      ["GitHub Sponsors ↗", sponsor],
    ],
  },
]
---

<footer class="site-footer">
  <div class="wrap footer-main">
    <div class="footer-brand">
      <a href={route()} aria-label="CyxCode home"><Logo /></a><p>We automate the AI<br />that automates us.</p><span
        >AN OPEN-SOURCE CYXWIZ LAB PROJECT</span>
    </div>
    <nav class="footer-links" aria-label="Footer">
      {
        groups.map((group) => (
          <div>
            <h2>{group.title}</h2>
            {group.links.map(([label, href]) => (
              <a
                href={href}
                target={href.startsWith("https:") ? "_blank" : undefined}
                rel={href.startsWith("https:") ? "noreferrer noopener" : undefined}
              >
                {label}
              </a>
            ))}
          </div>
        ))
      }
    </nav>
  </div>
  <div class="wrap footer-bottom">
    <p>© {year} CyxWiz Lab. Built with intent.</p><p>
      Forked from <a href={opencode} target="_blank" rel="noreferrer noopener">OpenCode ↗</a><span> / </span><a
        href={`${repo}/blob/dev/LICENSE`}
        target="_blank"
        rel="noreferrer noopener">License</a>
    </p>
  </div>
</footer>
<style>
  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: 80px;
  }
  .footer-main {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 50px;
    padding-block: 60px;
  }
  .footer-brand :global(.logo) {
    width: 155px;
    height: auto;
  }
  .footer-brand p {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.8;
    margin: 19px 0 23px;
  }
  .footer-brand > span {
    color: var(--faint);
    font: 8px var(--font-mono);
    letter-spacing: 1.1px;
  }
  .footer-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
  }
  .footer-links h2 {
    font-size: 12px;
    letter-spacing: 0;
    font-weight: 500;
    margin-bottom: 17px;
  }
  .footer-links a {
    display: block;
    font-size: 12px;
    color: var(--faint);
    padding-block: 7px;
  }
  a:hover {
    color: var(--mint);
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding-block: 22px;
    border-top: 1px solid var(--line);
    color: var(--faint);
    font-size: 10px;
  }
  .footer-bottom span {
    padding-inline: 9px;
  }
  @media (max-width: 700px) {
    .footer-main {
      grid-template-columns: 1fr;
      padding-block: 40px;
      gap: 40px;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 12px;
    }
    .footer-links {
      gap: 15px;
    }
  }
</style>
