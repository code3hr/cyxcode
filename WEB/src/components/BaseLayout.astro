---
import "../styles/globals.css"
import Header from "./Header.astro"
import Footer from "./Footer.astro"
import { route } from "../data/site"
interface Props {
  title: string
  description?: string
  path?: string
  ogTitle?: string
}
const {
  title,
  description = "CyxCode brings project memory, local error recovery, and governed tools to an open-source AI coding workflow.",
  path = "/",
  ogTitle,
} = Astro.props
const heading = title === "CyxCode" ? "CyxCode — Your code. Your context. Your agent." : `${title} — CyxCode`
const canonical = new URL(route(path), Astro.site)
const image = new URL(route("/gallery/screenshot-cyxcode.png"), Astro.site)
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{heading}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c110f" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={route("/favicon.svg")} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={ogTitle ?? heading} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CyxCode" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content="A CyxCode terminal session" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle ?? heading} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header path={path} />
    <main class="wrap site-main" id="main" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
